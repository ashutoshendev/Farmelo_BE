<?xml version="1.0" encoding="utf-8"?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Warn"
      internalLogFile="${basedir}/logs/internal-nlog.txt">

  <extensions>
    <add assembly="NLog.Web.AspNetCore" />
  </extensions>

  <variable name="layout"
            value="${longdate}|${logger}|${uppercase:${level}}|${message} ${exception}|url:${aspnet-request-url}|action:${aspnet-mvc-action}" />

  <targets>
    <target xsi:type="File"
            name="allLogs"
            fileName="${basedir}/logs/farmelo-all-${shortdate}.log"
            archiveAboveSize="50000000"
            layout="${layout}" />

    <target xsi:type="File"
            name="errorLogs"
            fileName="${basedir}/logs/farmelo-error-${shortdate}.log"
            archiveAboveSize="50000000"
            layout="${layout}" />

    <target xsi:type="Null" name="blackhole" />
  </targets>

  <rules>
    <logger name="Microsoft.*" minlevel="Trace" writeTo="blackhole" final="true" />
    <logger name="*" minlevel="Trace" writeTo="allLogs" />
    <logger name="*" minlevel="Error" maxlevel="Error" writeTo="errorLogs" />
  </rules>
</nlog>
