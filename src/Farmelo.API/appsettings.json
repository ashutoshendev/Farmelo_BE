{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DatabaseConnection": ""
  },
  "ToggleSettings": {
    "DisplayStackTrace": true,
    "RequestLogEnabled": true
  },
  "Integrations": {
    "SystemApi": {
      "ApiClient": "",
      "ApiSecret": "",
      "URL": ""
    }
  },
  "DataProtection": {
    "Purpose": "Farmelo"
  },
  "CorsAllowedOrigins": {
    "Allowed": "*"
  },
  "AuditLogs": {
    "AuditLogEnable": false
  },
  "AuthOptions": {
    "CookieName": "Farmelo.Auth",
    "ExpireHours": 8,
    "RememberMeDays": 7,
    "SlidingExpiration": true,
    "SameSite": "Lax",
    "RequireHttps": false
  },
  "FileStorage": {
    "RootPath": ""
  }
}
